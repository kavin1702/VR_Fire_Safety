  instructions:
  - {fileID: 8300000, guid: 378d067e071df6f44a89dab7cb2ce579, type: 3}
  - {fileID: 8300000, guid: ce47b2c5a55bf154f9ea54851346931e, type: 3}
  - {fileID: 8300000, guid: 6e7a8434fb75c1a42b0b6cd1b5c6550d, type: 3}
  - {fileID: 8300000, guid: e3a36f407429df4448a984891552f150, type: 3}
  - {fileID: 8300000, guid: c286a8a873efff94383c292ba0865be2, type: 3}
  - {fileID: 8300000, guid: 0873bd2ca33d0d540893774a93cd7978, type: 3}
  - {fileID: 8300000, guid: f17f28bb6198dcc44a8dec560d5db0c5, type: 3}
  - {fileID: 8300000, guid: b866ead8f5d47e7448d956ae4199d708, type: 3}
  instructionTexts:
  - '"Warning! A fire has started in the office. Stay calm and follow the procedure."'
  - '"Pick up the hammer to break the safety glass."'
  - '"Good job! Now press the alarm button inside the red box."'
  - '"Use the telephone to report the emergency,Select Fire Service to send information".'
  - '"Grab the fire extinguisher from the wall."'
  - '"Pull out the safety pin to unlock the extinguisher."'
  - '"Aim at the base of the flames and spray in a sweeping motion."'
  - '"Excellent! The fire has been extinguished. Simulation complete."'
  Panel: {fileID: 31972979}
